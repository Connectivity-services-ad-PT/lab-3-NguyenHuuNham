{
  "info": {
    "_postman_id": "fit4110-lab03-team-gate",
    "name": "FIT4110 Lab03 — team-gate Access Gate Contract Tests",
    "description": "Postman Collection cho team-gate: Core Business Access Policy API Contract Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('traceId', 'trace-' + Date.now());",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: pm.variables.get('traceId') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00_Health",
      "item": [
        {
          "name": "GET /health - service is alive",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has status=ok', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('status');",
              "  pm.expect(json.status).to.eql('ok');",
              "});",
              "pm.test('Response has service field', function () {",
              "  pm.expect(pm.response.json().service).to.eql('core-business');",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "POST /access/check - allow entry (happy path)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/access/check", "host": ["{{baseUrl}}"], "path": ["access","check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"RFID-2026-001\",\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"IN\",\n  \"timestamp\": \"2026-05-10T08:00:00Z\",\n  \"idempotencyKey\": \"0196fb3d-4ad7-7d1e-9f49-5d5148d2babe\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has decision ALLOW', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('decision');",
              "  pm.expect(json.decision).to.eql('ALLOW');",
              "});",
              "pm.test('Response has decisionId', function () {",
              "  pm.expect(pm.response.json()).to.have.property('decisionId');",
              "});"
            ]}
          }]
        },
        {
          "name": "POST /access/check - deny entry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "example=denied" }
            ],
            "url": { "raw": "{{baseUrl}}/access/check", "host": ["{{baseUrl}}"], "path": ["access","check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"RFID-2026-001\",\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"IN\",\n  \"timestamp\": \"2026-05-10T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has decision DENY and reasonCode', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.decision).to.eql('DENY');",
              "  pm.expect(json.reasonCode).to.eql('CARD_EXPIRED');",
              "});"
            ]}
          }]
        },
        {
          "name": "GET /policies/access - list policies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/policies/access?limit=10",
              "host": ["{{baseUrl}}"], "path": ["policies","access"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has items array', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('items');",
              "  pm.expect(json.items).to.be.an('array');",
              "});"
            ]}
          }]
        },
        {
          "name": "GET /policies/access/{policyId} - get policy by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/policies/access/0196fb3d-4ad7-7d1e-9f49-5d5148d2bac0",
              "host": ["{{baseUrl}}"], "path": ["policies","access","0196fb3d-4ad7-7d1e-9f49-5d5148d2bac0"]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has valid policyId', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.policyId).to.eql('0196fb3d-4ad7-7d1e-9f49-5d5148d2bac0');",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "POST /access/check - missing token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/access/check", "host": ["{{baseUrl}}"], "path": ["access","check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"RFID-2026-001\",\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"IN\",\n  \"timestamp\": \"2026-05-10T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Unauthorized request returns 401', function () {",
              "  pm.expect(pm.response.code).to.eql(401);",
              "});"
            ]}
          }]
        },
        {
          "name": "POST /access/check - wrong token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer invalid-token-xyz" }
            ],
            "url": { "raw": "{{baseUrl}}/access/check", "host": ["{{baseUrl}}"], "path": ["access","check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"RFID-2026-001\",\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"IN\",\n  \"timestamp\": \"2026-05-10T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const env = pm.environment.get('env');",
              "if (env === 'local') {",
              "  pm.test('Wrong token returns 401 on real service', function () {",
              "    pm.expect(pm.response.code).to.eql(401);",
              "  });",
              "} else {",
              "  pm.test('NOTE: Prism mock does not validate token format — only absence triggers 401', function () {",
              "    pm.expect([200, 401]).to.include(pm.response.code);",
              "  });",
              "}"
            ]}
          }]
        }
      ]
    },
    {
      "name": "03_Negative",
      "item": [
        {
          "name": "POST /access/check - missing cardId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/access/check", "host": ["{{baseUrl}}"], "path": ["access","check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"IN\",\n  \"timestamp\": \"2026-05-10T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Missing cardId returns 400 or 422', function () {",
              "  pm.expect([400, 422]).to.include(pm.response.code);",
              "});",
              "pm.test('Error response follows Problem details', function () {",
              "  const json = pm.response.json();",
              "  pm.expect([400, 422]).to.include(json.status);",
              "  pm.expect(json).to.have.property('title');",
              "});"
            ]}
          }]
        },
        {
          "name": "POST /access/check - invalid direction enum",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/access/check", "host": ["{{baseUrl}}"], "path": ["access","check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"RFID-2026-001\",\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"SIDEWAYS\",\n  \"timestamp\": \"2026-05-10T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Invalid direction enum returns 400 or 422', function () {",
              "  pm.expect([400, 422]).to.include(pm.response.code);",
              "});"
            ]}
          }]
        },
        {
          "name": "GET /policies/access/{policyId} - non-existent policy UUID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=404" }
            ],
            "url": {
              "raw": "{{baseUrl}}/policies/access/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"], "path": ["policies","access","00000000-0000-0000-0000-000000000000"]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Non-existent policy ID returns 404', function () {",
              "  pm.expect(pm.response.code).to.eql(404);",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "GET /policies/access - limit at max boundary (100)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/policies/access?limit=100",
              "host": ["{{baseUrl}}"], "path": ["policies","access"],
              "query": [{ "key": "limit", "value": "100" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Max limit=100 returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Items count does not exceed limit', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.items.length).to.be.at.most(100);",
              "});"
            ]}
          }]
        },
        {
          "name": "GET /policies/access - limit out of range (0)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/policies/access?limit=0",
              "host": ["{{baseUrl}}"], "path": ["policies","access"],
              "query": [{ "key": "limit", "value": "0" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('limit=0 is rejected or handled', function () {",
              "  pm.expect([200, 400, 422]).to.include(pm.response.code);",
              "});"
            ]}
          }]
        },
        {
          "name": "POST /access/check - cardId pattern mismatch",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/access/check", "host": ["{{baseUrl}}"], "path": ["access","check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"RFID-123\",\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"IN\",\n  \"timestamp\": \"2026-05-10T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
